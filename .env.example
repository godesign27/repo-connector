# mock | github
CONNECTOR_MODE=mock
APP_BASE_URL=http://127.0.0.1:43127
DATABASE_PATH=./data/repo-connector.sqlite

# Used for AES-256-GCM at rest and HMAC install-state signatures
ENCRYPTION_KEY=replace-with-a-long-random-string
ADMIN_SECRET=replace-with-admin-password
REPO_CONNECTOR_API_KEY=replace-with-api-key

# Required only when CONNECTOR_MODE=github
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
